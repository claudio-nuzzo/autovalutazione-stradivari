{
  "name": "didattica-metodi",
  "private": true,
  "type": "module",
  "scripts": {
    "build:pdf": "esbuild pdf-vendor-entry.mjs --bundle --platform=browser --target=es2020 --format=iife --minify --outfile=autovalutazione-app/vendor/jspdf.js",
    "test:archive": "node --test tests/archive.test.mjs",
    "test:workerd": "node --test tests/archive-workerd.test.mjs",
    "test:browser": "node tests/teacher-path.cjs",
    "test:progress": "node --test tests/progress-drive-model.test.cjs tests/progress-storage.test.cjs",
    "test:progress-browser": "node tests/progress-drive-browser.cjs",
    "test:grammar-browser": "node tests/grammar-browser.cjs",
    "test:grammar-adapter": "node tests/grammar-adapter.cjs",
    "test:grammar-assessments": "node tests/grammar-assessments.cjs && node tests/grammar-assessment-browser.cjs",
    "test:grammar-migration": "node tests/grammar-migration.cjs",
    "test:grammar-game": "node tests/grammar-game.cjs",
    "test:grammar-races": "node tests/grammar-races.cjs && node tests/grammar-race-browser.cjs"
  },
  "dependencies": {
    "jspdf": "4.2.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261001.0-alpha",
    "pdfjs-dist": "6.5.438",
    "playwright": "1.62.1"
  }
}
